{
  "name": "noteflow-hackathon-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "agent.ts",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "adk api_server",
    "start": "node server.mjs",
    "test": "tsc --noEmit",
    "deploy": "adk deploy cloud_run --service_name=noteflow-agent --with_ui",
    "worker": "node background-worker.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.0.0",
    "@google-cloud/pubsub": "6.0.1",
    "@google/adk": "1.6.0",
    "@google/genai": "2.17.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@google/adk-devtools": "1.6.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.19.0"
}
