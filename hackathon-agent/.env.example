# Gemini 3.5 through Vertex AI (no service-account key is stored in this repository)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Created during Google Cloud setup
NOTEFLOW_ANALYSIS_TOPIC=noteflow-deep-analysis

# Shared only between the Sites server proxy and Cloud Run. Generate a random value.
NOTEFLOW_AGENT_SHARED_SECRET=replace-with-a-random-server-only-value
