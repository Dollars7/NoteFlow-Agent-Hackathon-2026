# Public Supabase Auth configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional hackathon Agent connection. Keep both values server-only.
# Leave them blank to use the clearly labeled local preview.
NOTEFLOW_AGENT_URL=
NOTEFLOW_AGENT_SHARED_SECRET=
