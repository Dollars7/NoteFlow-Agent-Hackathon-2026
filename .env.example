# Public Supabase Auth configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional hackathon agent connection. Leave blank for the labeled local preview.
NEXT_PUBLIC_NOTEFLOW_AGENT_URL=
NEXT_PUBLIC_NOTEFLOW_AGENT_APP_NAME=agent
